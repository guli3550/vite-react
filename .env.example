# Frontend
VITE_API_URL=https://YOUR-BACKEND-URL.onrender.com

# Backend (set these in Render environment variables)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Admin panel — keep these only in Render/backend environment variables
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Click SHOP API — keep these only in Render/backend environment variables
CLICK_SERVICE_ID=REPLACE_WITH_CLICK_SERVICE_ID
CLICK_MERCHANT_ID=REPLACE_WITH_CLICK_MERCHANT_ID
CLICK_SECRET_KEY=REPLACE_WITH_CLICK_SECRET_KEY
