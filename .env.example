# Frontend
VITE_API_URL=https://guli-gateway.parizodabaxtiyorov.workers.dev

# Backend (set these in Render environment variables)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Telegram product auto-publishing
# Comma-separated channel/group chat IDs or @usernames. Example: -1001234567890,-1009876543210
TELEGRAM_PRODUCT_CHAT_IDS=
# 1 = also send new products to Telegram users stored in Supabase (users who have interacted with the bot/app)
TELEGRAM_PRODUCT_BROADCAST=1
# Public Mini App URL used by Telegram product buttons
MINI_APP_URL=https://guli-lingerie-web.onrender.com/?tgapp=v20260826

# Admin panel — keep these only in Render/backend environment variables
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Manual HUMO / UZCARD card-to-card payment — never commit the real values
CARD_PAYMENT_NUMBER=0000000000000000
CARD_PAYMENT_NAME=Example Holder Name
