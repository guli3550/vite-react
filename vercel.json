{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Telegram-Init-Data, X-GULI-Client, X-Guli-Guest-Token, X-Guli-Linked-Token"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://gulii.uz/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.gulii.uz"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/google-merchant-feed.xml",
      "destination": "/api/google-merchant-feed"
    },
    {
      "source": "/product/:ref/",
      "destination": "/api/product/:ref"
    },
    {
      "source": "/product/:ref",
      "destination": "/api/product/:ref"
    },
    {
      "source": "/api/:path*",
      "destination": "https://guli-lingerie-api.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
