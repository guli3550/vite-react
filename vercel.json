{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://gulii.uz/:path*",
      "permanent": true,
      "has": [
        { "type": "host", "value": "www.gulii.uz" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/product/:ref/", "destination": "/api/product/:ref" },
    { "source": "/product/:ref", "destination": "/api/product/:ref" },
    { "source": "/api/:path*", "destination": "https://guli-lingerie-api.onrender.com/api/:path*" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
